* PlantUML corrección sin clase Agenda
@startuml Retirosteam MODP
left to right direction
class Usuario {
  -nombre
  -apellido
  -email
  -telefono
  -notificacion:Notificacion
  +crear()
  +modificar()
  +mostrarPerfil()
  +obtenerNombre()
  +obtenerApellido()
  +obtenerEmail()
  +obtenerTelefono()
  +obtenerNotificacion()
  +tomarNombre()
  +tomarApellido()
  +tomarEmail()
  +tomarTelefono()
  +tomarNotificacion()
}
class Retiro {
  -nombre
  -descripcion
  -objetivosPersonales
  -fechaInicio
  -duracion
  -estado
  -climaEsperado
  -contactoOrganizador
  -generoDelPublico
  -cantidadDelPublico
  -precio
  -nivelPrivacidad
  -nivelAtencion  
  -comentarioAdicional
  -puntuacion
  -cronogramaActividades
  -servicios
  -politicasCancelacion
  -ubicacion: Ubicacion 
  -fotografias
  +crear()
  +consultar()
  +registrar()
  +modificar()
  +buscar(f: filtro)
  +obtenerCronograma()
  +agendar()
  +obtenerRetirosAgendados()
  +obtenerProximoRetiro()
}
class Notificacion {
  -hora
  -titulo
  -descripción
  -evento
  +crear()
  +modificar()
  +mostrar()
  +notificar()
  +desactivar()
  +activar()
}
class Ubicacion {
  -pais
  -provincia
  -ciudad
  -direccion
  +crear()
  +obtenerDireccionCompleta()
}
Usuario "1" --> "0..*" Retiro : administra y agenda
Usuario "1" --> "0..*" Notificacion : recibe
Retiro "1" --> "0..*" Notificacion : genera
Retiro "0..*" --> "1" Ubicacion : se realiza en
note top of Usuario : Los métodos de navegación \n de esta clase se extienden \n a todo el diagrama
@enduml


* PlantUML corrección con clase Agenda
@startuml Retirosteam MODP
left to right direction
class Agenda {
  -calendario
  -retirosAgendados
  -retiro:Retiro
  +crear()
  +mostrar()
  +agendarRetiro()
  +obtenerRetirosAgendados()
  +obtenerProximoRetiro()
  +modificarRetiroAgendado()
  +eliminarRetiroAgendado()
  +buscarRetiro(f: filtro)
}
class Usuario {
  -nombre
  -apellido
  -email
  -telefono
  -agenda:Agenda
  -notificacion:Notificacion
  +crear()
  +modificar()
  +mostrarPerfil()
  +buscarRetirosRegistrados(f: filtro)
  +obtenerNombre()
  +obtenerApellido()
  +obtenerEmail()
  +obtenerTelefono()
  +obtenerAgenda()
  +obtenerNotificacion()
  +tomarNombre()
  +tomarApellido()
  +tomarEmail()
  +tomarTelefono()
  +tomarAgenda()
  +tomarNotificacion()
}
class Retiro {
  -nombre
  -descripcion
  -objetivosPersonales
  -fechaInicio
  -duracion
  -estado
  -climaEsperado
  -contactoOrganizador
  -generoDelPublico
  -cantidadDelPublico
  -precio
  -nivelPrivacidad
  -nivelAtencion  
  -comentarioAdicional
  -puntuacion
  -cronogramaActividades
  -servicios
  -politicasCancelacion
  -ubicacion: Ubicacion 
  -fotografias
  +crear()
  +registrar()
  +modificar()
  +consultar()
  +obtenerCronograma()
  +obtenerRetirosRegistrados()
}
class Ubicacion {
  -pais
  -provincia
  -ciudad
  -direccion
  +crear()
  +obtenerDireccionCompleta()
}
class Notificacion {
  -hora
  -titulo
  -descripción
  -evento
  +crear()
  +modificar()
  +mostrar()
  +notificar()
  +desactivar()
  +activar()
}
Usuario --> "0..*" Notificacion : recibe
Retiro "1" --> "0..*" Notificacion : genera
Retiro --> "1" Ubicacion : se ubica en
Usuario *-- "1" Agenda
Agenda --> "0..*" Retiro : contiene
Usuario --> "0..*" Retiro : administra
note top of Usuario : Los métodos de navegación \n de esta clase se extienden \n a todo el diagrama
@enduml
