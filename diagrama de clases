  - nombre : String
  - contactoOrganizador : String
  - fechaInicio : Date
  - duracion : Integer
  - disponibilidad : String
  - estado : String
  - objetivosPersonales : String
  - generoDelPublico : String
  - cantidadDelPublico : String
  - climaEsperado : String
  - precio : Decimal
  - nivelPrivacidad : String
  - nivelAtencion : String
